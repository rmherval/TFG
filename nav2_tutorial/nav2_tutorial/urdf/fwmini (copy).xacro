  <joint name="robot_to_falang003" type="fixed">
    <parent link="base_link"/>
    <child link="falang003"/>
    <origin rpy="0 0 0" xyz="0.125 0.17507 -0.019"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="robot_to_falang007" type="fixed">
    <parent link="base_link"/>
    <child link="falang007"/>
    <origin rpy="0 0 0" xyz="-0.125 0.17493 -0.019 "/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="robot_to_falang011" type="fixed">
