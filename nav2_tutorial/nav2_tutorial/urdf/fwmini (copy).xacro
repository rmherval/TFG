  </joint>

  <joint name="lunzi002_to_lunzi" type="continuous">
    <parent link="lunzi002"/>
    <child link="lunzi"/>
    <origin rpy="0 0 0" xyz=" -0.027 0.0 -0.077"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="lunzi006_to_lunzi004" type="continuous">
